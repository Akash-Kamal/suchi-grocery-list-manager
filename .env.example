# Suchi Grocery App — Environment Variables
# ─────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Supabase (required for household sharing feature) ────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Base URL for shareable invite links.
# In development: http://localhost:5174
# In production: https://your-deployed-app.com
VITE_APP_URL=http://localhost:5174

# ── Edge Function only (NEVER put this in the client app) ────────────────────
# Used by the redeem-invite Edge Function at runtime via Deno.env.
# Supabase automatically injects SUPABASE_SERVICE_ROLE_KEY into Edge Functions.
# You do NOT need to set this manually.
# SUPABASE_SERVICE_ROLE_KEY=<injected-automatically-by-supabase>
